  32 PLOT 0,16: DRAW 24,-16: DRAW 205,0: DRAW 24,16
  33 PLOT 0,8: DRAW 12,-8: DRAW 230,0: DRAW 12,8
  39 PRINT AT 21,basepos;"{92}{8F}{93}";AT 20,basepos;"{98} {98}"
