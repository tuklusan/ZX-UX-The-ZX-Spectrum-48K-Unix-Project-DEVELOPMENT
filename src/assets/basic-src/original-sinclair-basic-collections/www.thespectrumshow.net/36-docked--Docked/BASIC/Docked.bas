  60 IF INKEY$<>"" THEN GO TO 80
  65 INK 3: PRINT AT 0,0;"Score=";sc;AT 0,22;"  Fuel=";fuel;"  "
  70 GO TO 40
  80 GO SUB 1000
  90 GO SUB 1100
