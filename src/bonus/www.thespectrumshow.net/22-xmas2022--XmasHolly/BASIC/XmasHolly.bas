   1 REM "*** XMAS HOLLY ***"
   2 REM * SINCLAIR SPECTRUM *
   3 REM "by E.A.DUNCAN-DUNLOP"
   4 REM 1 DAN-Y-LAN ABERKENFIG
   5 REM Nr BRIDGEND MID GLAM
   6 REM Typed by Paul Jenkinson
  20 LET c=25: LET b=7
  25 BORDER 0: PAPER 0: INK 4: CLS 
  30 FOR A=5 TO 230 STEP 40
  40 PLOT a,b
  50 LET C=(RND*40)+10
  60 DRAW C,C,1
  70 DRAW -C/3,-C/5,-2
  80 DRAW -C/2.5,-C/5,-2
  90 DRAW -C/5,-C/3.4,-2
 100 DRAW -C/10,-C/3,-2
 110 REM Other half of leaf
 120 DRAW C/2.5,-C/10,-2
 130 DRAW C/3.4,C/5,-2
 140 DRAW C/3.4,C/3.4,-2
 150 DRAW 0,C/2,-1
 160 NEXT A
 170 LET B=B+50
 180 IF B<150 THEN GO TO 30
