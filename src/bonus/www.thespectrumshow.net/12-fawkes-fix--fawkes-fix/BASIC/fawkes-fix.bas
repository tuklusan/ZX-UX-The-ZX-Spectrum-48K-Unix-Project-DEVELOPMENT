   1 REM Guy Fawkes Night
   2 REM By Andrew Bird
   6 LET m1=50000: LET m2=50012: LET m3=50024
  10 CLS : GO SUB 9000: GO SUB 7000
  20 DIM x(500): DIM y(500)
  30 LET x(1)=20: LET x(2)=20
  40 LET y(1)=15: LET y(2)=15
  50 LET trail=.96: LET t1=2: LET gp=0: LET t2=2: LET a=20: LET b=15
  60 LET g$="{97}{97}{97}{97}{97}{97}{97}{97}{97}{97}"
  70 RANDOMIZE 
  99 REM Draw Screen 1
 100 BORDER 0: PAPER 0: INK 7: BRIGHT 1: CLS 
 110 PRINT AT 0,0; INVERSE 1; PAPER 7; INK 1;"  GUY FAWKES NIGHT   By A.Brid  "
 120 FOR f=1 TO 19: PRINT AT f,0; INK 1;"{8A}";AT f,31;"{85}": NEXT f
 130 PRINT AT 20,0; INK 1;"{8A}"
 140 PRINT AT 21,0; INVERSE 1; PAPER 7; INK 1;"                            Exit"
 150 FOR f=1 TO 70: PRINT AT INT (RND*17)+3,INT (RND*27)+3; PAPER 2; INK 6;"{98}"
 160 NEXT f
 170 FOR f=1 TO 8: PRINT AT INT (RND*14)+5,INT (RND*25)+4; INK 5;"{97}": NEXT f
 180 PRINT AT a,b; INK 5; BRIGHT 1;"{96}"
 200 IF INKEY$<>"" THEN GO TO 220
 210 GO TO 200
 220 PRINT AT 0,21; PAPER 1; BRIGHT 1;"         "
 900 BRIGHT 0: INK 4
 999 REM Main Loop
1000 LET t1=t1+1: PRINT AT a,b; INK 5; BRIGHT 1;"{96}"
1005 PRINT AT 0,21; PAPER 1; INK 5; BRIGHT 1;g$( TO gp)
1010 IF RND>trail THEN GO SUB 2000
1015 IF INKEY$="o" AND b>1 THEN GO TO 1500
1020 IF INKEY$="a" AND a<20 THEN GO TO 1600
1025 IF INKEY$="q" AND a>2 THEN GO TO 1700
1030 IF INKEY$="p" AND b<30 THEN GO TO 1800
1050 IF gp>=8 THEN PRINT AT 21,0; PAPER 1; INK 7;" You may now leave this screen  ";AT 20,31; INK 0; FLASH 1;" "
1060 IF gp>=8 AND a=20 AND b>=30 THEN GO TO 5000
1100 GO TO 1010
1500 IF ATTR (a,b-1)=69 THEN LET d=USR m3: LET gp=gp+1: GO TO 1540
1510 IF ATTR (a,b-1)=86 THEN PRINT AT a,b;" ": LET b=b-1: GO TO 3000
1520 IF SCREEN$ (a,b-1)<>" " THEN GO TO 1010
1540 LET b=b-1
1550 LET x(t1)=a: LET y(t1)=b
1560 IF x(t1-2)=a THEN PRINT AT a,b+1;"{90}"
1570 IF x(t1-2)>a THEN PRINT AT a,b+1;"{93}"
1580 IF x(t1-2)<a THEN PRINT AT a,b+1;"{94}"
1590 GO TO 1000
1600 IF ATTR (a+1,b)=69 THEN LET d=USR m3: LET gp=gp+1: GO TO 1640
1610 IF ATTR (a+1,b)=86 THEN PRINT AT a,b;" ": LET a=a+1: GO TO 3000
1620 IF SCREEN$ (a+1,b)<>" " THEN GO TO 1010
1640 LET a=a+1
1650 LET x(t1)=a: LET y(t1)=b
1660 IF y(t1-2)=b THEN PRINT AT a-1,b;"{91}"
1670 IF y(t1-2)>b THEN PRINT AT a-1,b;"{92}"
1680 IF y(t1-2)<b THEN PRINT AT a-1,b;"{93}"
1690 GO TO 1000
1700 IF ATTR (a-1,b)=69 THEN LET d=USR m3: LET gp=gp+1: GO TO 1740
1710 IF ATTR (a-1,b)=86 THEN PRINT AT a,b;" ": LET a=a-1: GO TO 3000
1720 IF SCREEN$ (a-1,b)<>" " THEN GO TO 1010
1740 LET a=a-1
1750 LET x(t1)=a: LET y(t1)=b
1760 IF y(t1-2)=b THEN PRINT AT a+1,b;"{91}"
1770 IF y(t1-2)>b THEN PRINT AT a+1,b;"{95}"
1780 IF y(t1-2)<b THEN PRINT AT a+1,b;"{94}"
1790 GO TO 1000
1800 IF ATTR (a,b+1)=69 THEN LET d=USR m3: LET gp=gp+1: GO TO 1840
1810 IF ATTR (a,b+1)=86 THEN PRINT AT a,b;" ": LET b=b+1: GO TO 3000
1820 IF SCREEN$ (a,b+1)<>" " THEN GO TO 1010
1840 LET b=b+1
1850 LET x(t1)=a: LET y(t1)=b
1860 IF x(t1-2)=a THEN PRINT AT a,b-1;"{90}"
1870 IF x(t1-2)>a THEN PRINT AT a,b-1;"{92}"
1880 IF x(t1-2)<a THEN PRINT AT a,b-1;"{95}"
1890 GO TO 1000
2000 LET trail=trail-.02
2010 PRINT AT x(t2),y(t2); BRIGHT 1; OVER 1; INK 6;" ": BEEP .0005,60
2020 PRINT AT x(t2-1),y(t2-1);" "
2030 LET t2=t2+1
2040 IF t2=t1 THEN GO TO 4000
2050 RETURN 
2999 REM  Runs into bonfire
3000 PAPER 6: INK 2
3010 PRINT AT a,b; FLASH 1;"{96}"
3020 FOR f=1 TO 100
3030 OUT 254,RND*255
3040 NEXT f: BORDER 1: CLS 
3050 RANDOMIZE USR m2
3060 FOR f=1 TO 7: PRINT AT f,2; FLASH 1;"                           ": NEXT f
3070 PRINT AT 2,3; FLASH 1;"BAD LUCK.   GUY FAWKES IS";AT 4,3;"BURNING AND THE HOUSES OF";AT 6,3;"PARLIAMENT ARE NOW SAFE."
3080 FOR f=1 TO 30: RANDOMIZE USR m3: NEXT f
3090 PRINT AT 21,0; PAPER 6; INK 0;"  Pres any key to play again.  ": PAUSE 0: CLS : GO TO 20
3999 REM Trail catches up
4000 BORDER 0: PAPER 0: CLS 
4010 FOR f=-30 TO 0 STEP .3: OUT 254,f: BEEP .01,f: OUT 254,90-f
4020 PRINT AT a,b; INK 7; OVER 1;"{96}": NEXT f
4030 PRINT AT a,b;" ": RANDOMIZE USR m3
4040 FOR f=1 TO 50: BEEP .01,30-f: BORDER 1: BORDER 2: BORDER 1:: BORDER 0: NEXT f
4050 BORDER 1: RANDOMIZE USR m2
4060 FOR f=1 TO 7: PRINT AT f,2; PAPER 6;"                              ": NEXT f
4070 PRINT AT 2,3; PAPER 6; INK 0;"BANG !! GUY HAS BEEN TOO";AT 4,3;"SLOW. THE BURNING TRAIL HAS";AT 6,3;"JUST CAUGHT UP WITH HIM."
4080 GO TO 3080
4999 REM Reach screen two
5000 BORDER 1
5010 RANDOMIZE USR m2
5020 FOR f=0 TO 16: PRINT AT 20,f; PAPER 4; INK 1;"{90}{96}"
5030 BEEP .06,-40: NEXT f
5040 PRINT AT 20,16; PAPER 4; INK 7;"{97}"
5050 FOR f=17 TO 30: PRINT AT 20,f; PAPER 4; INK 1;" {96}"
5060 BEEP .06,-40: NEXT f
5070 PRINT AT 20,31; PAPER 4;" "
5080 FOR f=0 TO 14: PRINT AT 20,f; PAPER 4; INK 6;"  "
5090 OUT 254,RND*255: PAUSE 2: NEXT f
5100 FOR f=1 TO 10: POKE 50016,INT (RND*255)+1: POKE 50017,INT (RND*10)+205
5110 FOR n=1 TO 4: OUT 254,n*3: OUT 254,100-n*3: NEXT n
5120 LET d=USR m2
5130 NEXT f
5140 BORDER 0: PAPER 0: INK 2: CLS 
5150 FOR f=8 TO 14: PRINT AT f,1; PAPER 7;"                              ": NEXT f
5160 PRINT AT 9,5; PAPER 7;"W E L L    D O N E !";AT 11,3;"GUY FAWKES HAS JUST DONE";AT 13,3;"THE COUNTRY A BIG FAVOUR."
5170 PRINT AT 21,1; PAPER 7;" Press any key to play again "
5180 FOR f=1 TO 30: RANDOMIZE USR m3: NEXT f
5190 IF INKEY$<>"" THEN GO TO 1
5200 GO TO 5190
6999 REM  Instructions
7000 LET i$="HELP GUY FAWKES as he tries to  blow up the houses of parliamentHis barrel of gun powder is     leaking and so he must re-fill  it 8 times from the ones on     screen 1 before he can place it under the Houses of Parliamet. "
7010 LET i$=i$+"  However he cannot cross his    own trail, he must not walk intoany of the bonfires and should  he be too slow the buring trail may well catch up with him.       "
7100 BORDER 5: PAPER 5: INK 0: CLS 
7110 FOR f=19 TO 21: PRINT AT f,0; PAPER 4;"                                ": NEXT f
7115 PRINT AT 20,4; PAPER 4;"THE HOUSES OF PARLIAMENT"
7120 LET p=24: GO SUB 7200
7125 LET p=48: GO SUB 7200
7130 LET p=120: GO SUB 7200
7135 LET p=192: GO SUB 7200
7140 LET p=216: GO SUB 7200
