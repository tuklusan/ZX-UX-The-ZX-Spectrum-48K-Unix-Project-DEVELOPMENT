{
  "alias": "anagram",
  "cases": [
    {
      "name": "intro",
      "keys": "",
      "frames": 200,
      "expect": [
        "ANAGRAMMATIC",
        "PRESS ANY KEY"
      ],
      "capture": "01-intro.png",
      "fuse_steps": []
    },
    {
      "name": "main",
      "keys": "{WAIT 80}{SPACE}AE\\nN",
      "frames": 700,
      "expect": [
        "NUMBER OF LETTERS TO BEGIN"
      ],
      "capture": "02-main.png",
      "fuse_steps": [
        [
          0.3,
          " "
        ],
        [
          0.5,
          "AE\nN"
        ]
      ]
    },
    {
      "name": "output",
      "keys": "{WAIT 80}{SPACE}AE\\nN2\\n",
      "frames": 700,
      "expect": [
        "AE",
        "EA",
        "TYPE RUN FOR ANOTHER GO"
      ],
      "capture": "03-after-input.png",
      "fuse_steps": [
        [
          0.3,
          " "
        ],
        [
          0.5,
          "AE\nN2\n"
        ]
      ]
    },
    {
      "name": "known",
      "keys": "{WAIT 80}{SPACE}AB\\nY-X-\\n",
      "frames": 750,
      "expect": [
        "AXB",
        "BXA"
      ],
      "forbid": [
        "E R R O R!"
      ]
    },
    {
      "name": "reject",
      "keys": "{WAIT 80}{SPACE}AB\\nY---\\n-X-\\n",
      "frames": 750,
      "expect": [
        "E R R O R!",
        "AXB",
        "BXA"
      ]
    },
    {
      "name": "all-lengths",
      "keys": "{WAIT 80}{SPACE}ABC\\nN1\\n",
      "frames": 900,
      "expect": [
        "ABC",
        "ACB",
        "BAC",
        "BCA",
        "CAB",
        "CBA",
        "TYPE RUN FOR ANOTHER GO"
      ]
    },
    {
      "name": "restart",
      "keys": "{WAIT 80}{SPACE}AE\\nN2\\nR{WAIT 80}{SPACE}AB\\nN2\\n",
      "frames": 1000,
      "expect": [
        "AB",
        "BA",
        "TYPE RUN FOR ANOTHER GO"
      ]
    },
    {
      "name": "scroll",
      "keys": "{WAIT 80}{SPACE}ABCD\\nN1\\n",
      "frames": 1200,
      "expect": [
        "THAT'S ALL THE POSSIBLE ANAGRAMS",
        "TYPE RUN FOR ANOTHER GO."
      ],
      "forbid": [
        "TYPE ONLY THOSE LETTERS",
        "ARE ANY LETTERS/SPACES KNOWN?"
      ]
    }
  ],
  "geometry": []
}
